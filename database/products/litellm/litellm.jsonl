{"cve": "CVE-2026-42208", "version": "N/A", "published": "2026-05-08T04:16:19.923", "lastModified": "2026-05-08T19:19:34.537", "description": "LiteLLM is a proxy server (AI Gateway) to call LLM APIs in OpenAI (or native) format. From version 1.81.16 to before version 1.83.7, a database query used during proxy API key checks mixed the caller-supplied key value into the query text instead of passing it as a separate parameter. An unauthenticated attacker could send a specially crafted Authorization header to any LLM API route (for example POST /chat/completions) and reach this query through the proxy's error-handling path. An attacker could read data from the proxy's database and may be able to modify it, leading to unauthorised access to the proxy and the credentials it manages. This issue has been patched in version 1.83.7.", "cvssScore": 9.8, "cvsseSeverity": "CRITICAL", "CWE": ["707", "74", "89", "943"], "CAPEC": ["13", "84", "76", "72", "135", "3", "279", "676", "47", "109", "66", "80", "7", "45", "470", "278", "83", "28", "250", "79", "53", "10", "24", "42", "276", "9", "34", "105", "277", "52", "108", "64", "8", "67", "267", "78", "71", "6", "14", "110", "120", "51", "273", "468", "43", "101", "46"], "TECHNIQUES": [{"id": "1027", "name": "ENTRY NAME", "tactics": []}, {"id": "1562.003", "name": "ENTRY NAME", "tactics": []}, {"id": "1574.006", "name": "ENTRY NAME", "tactics": []}, {"id": "1574.007", "name": "ENTRY NAME", "tactics": []}], "DEFEND": [{"id": "D3-FA", "tactic": "Detect", "technique": "File Analysis", "artifact": "File"}, {"id": "D3-FIM", "tactic": "Detect", "technique": "File Integrity Monitoring", "artifact": "File"}, {"id": "D3-DA", "tactic": "Detect", "technique": "Dynamic Analysis", "artifact": "Executable File"}, {"id": "D3-EFA", "tactic": "Detect", "technique": "Emulated File Analysis", "artifact": "Executable File"}, {"id": "D3-FEV", "tactic": "Evict", "technique": "File Eviction", "artifact": "File"}, {"id": "D3-DF", "tactic": "Deceive", "tec